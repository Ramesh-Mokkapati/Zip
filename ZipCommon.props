<?xml version="1.0" encoding="utf-8"?>
<!-- Compiler/linker settings shared by ZipEngineLib, ZipAppMFC and ZipEngineTests.
     Each .vcxproj imports this after Microsoft.Cpp.props so these values win. -->
<Project>
  <PropertyGroup>
    <OutDir>$(SolutionDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- The runbook asks for C++11; MSVC's oldest selectable standard is C++14, and the code uses only C++11 features. -->
      <LanguageStandard>stdcpp14</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <!-- Windows 7 API level -->
      <!-- LIBARCHIVE_STATIC: archive.h must not declare its functions as DLL imports (static vcpkg build). -->
      <PreprocessorDefinitions>_WIN32_WINNT=0x0601;WINVER=0x0601;LIBARCHIVE_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Runbook step 4.3: the engine header is found as "ZipEngine.h" from any project. -->
      <AdditionalIncludeDirectories>$(SolutionDir)ZipEngineLib;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <!-- Static CRT everywhere, matching the static vcpkg libraries and static MFC. -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
</Project>
